<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop rescap">
  <Identity
    Name="InjunaId.HDRSDRBrightnessAssistant"
    Publisher="CN=81C6B903-8D8C-435A-B42E-3678C731A484"
    Version="@VERSION4@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>HDR SDR Brightness Assistant</DisplayName>
    <PublisherDisplayName>InjunaId</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-hans" />
    <Resource Language="zh-hant" />
    <Resource Language="ko-kr" />
    <Resource Language="ja" />
    <Resource Language="ru" />
    <Resource Language="de" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="HdrSdrBrightness.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="HDR SDR Brightness Assistant"
        Description="HDR SDR Brightness Assistant"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="HdrSdrBrightness.exe"
          EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--background">
          <desktop:StartupTask
            TaskId="HdrSdrBrightnessStartup"
            Enabled="false"
            DisplayName="HDR SDR Brightness Assistant" />
        </desktop:Extension>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="HdrSdrBrightness.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="HdrSdrBrightnessStore.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
